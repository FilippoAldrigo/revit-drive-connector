<Window x:Class="RevitDriveConnector.Addin.UI.GoogleAccountWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Google Drive Connector - Gestione Account Google" Height="580" Width="680"
 WindowStartupLocation="CenterScreen"
 FontFamily="Segoe UI" FontSize="13"
 Background="#F8FAFC" ResizeMode="NoResize">

 <Grid Margin="20">
 <Grid.RowDefinitions>
 <RowDefinition Height="Auto"/>
 <RowDefinition Height="*"/>
 <RowDefinition Height="Auto"/>
 </Grid.RowDefinitions>

 <!-- Header -->
 <StackPanel Grid.Row="0" Margin="0,0,0,16">
 <TextBlock x:Name="TxtHeaderTitle" Text="Account Google &amp; Progetti Condivisi" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
 <TextBlock x:Name="TxtHeaderSubtitle" Text="Collega il tuo account Google per visualizzare e aprire direttamente i progetti condivisi con te dai tuoi colleghi." Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
 </StackPanel>

 <!-- Main Content -->
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
 <StackPanel>
 <!-- Status Card -->
 <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,16">
 <Grid>
 <Grid.ColumnDefinitions>
 <ColumnDefinition Width="64"/>
 <ColumnDefinition Width="*"/>
 <ColumnDefinition Width="Auto"/>
 </Grid.ColumnDefinitions>

 <!-- Avatar / Icon Placeholder -->
 <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="#E0F2FE" HorizontalAlignment="Left" VerticalAlignment="Center">
 <TextBlock Text="G" FontSize="22" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
 </Border>

 <!-- Account Info -->
 <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
 <TextBlock x:Name="TxtDisplayName" Text="Nessun Account Connesso" FontWeight="SemiBold" FontSize="15" Foreground="#1E293B"/>
 <TextBlock x:Name="TxtEmail" Text="Accedi con Google per abilitare la sincronizzazione dei progetti condivisi" Foreground="#64748B" Margin="0,2,0,0"/>
 <TextBlock x:Name="TxtStatus" Text="Stato: Non Connesso" Foreground="#E11D48" FontWeight="Medium" Margin="0,4,0,0"/>
 </StackPanel>

 <!-- Action Buttons -->
 <StackPanel Grid.Column="2" VerticalAlignment="Center">
 <Button x:Name="BtnConnect" Content="Accedi con Google" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="14,8" BorderThickness="0" Click="BtnConnect_Click"/>
 <Button x:Name="BtnDisconnect" Content="Disconnetti" Background="#F1F5F9" Foreground="#E11D48" FontWeight="SemiBold" Padding="12,6" BorderThickness="1" BorderBrush="#CBD5E1" Margin="0,6,0,0" Visibility="Collapsed" Click="BtnDisconnect_Click"/>
 </StackPanel>
 </Grid>
 </Border>

 <!-- Credentials Card -->
 <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,16">
 <StackPanel>
 <TextBlock x:Name="TxtCredHeader" Text="Configurazione Credenziali Google (OAuth 2.0)" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B"/>
 <TextBlock x:Name="TxtCredDesc" Text="Per consentire l'accesso sicuro all'API di Google Drive, e richiesto il file credentials.json generato su Google Cloud Console (Desktop App)." Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,10"/>

 <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
 <Button x:Name="BtnLoadCredentials" Content="Seleziona File credentials.json..." Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" Padding="12,7" BorderThickness="1" BorderBrush="#CBD5E1" Click="BtnLoadCredentials_Click"/>
 <TextBlock x:Name="TxtCredStatus" Text="Credenziali non configurate" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#E11D48" FontWeight="Medium"/>
 </StackPanel>

 <!-- Manual ID / Secret toggle -->
 <Expander x:Name="ExpManual" Header="Inserisci manualmente Client ID e Client Secret" Foreground="#475569">
 <StackPanel Margin="0,8,0,0">
 <TextBlock Text="Client ID:" Foreground="#334155" FontWeight="Medium"/>
 <TextBox x:Name="TxtClientId" Padding="6,4" BorderBrush="#CBD5E1" Margin="0,2,0,8"/>

 <TextBlock Text="Client Secret:" Foreground="#334155" FontWeight="Medium"/>
 <PasswordBox x:Name="TxtClientSecret" Padding="6,4" BorderBrush="#CBD5E1" Margin="0,2,0,10"/>

 <Button x:Name="BtnSaveManual" Content="Salva Credenziali Manuali" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="12,6" BorderThickness="0" HorizontalAlignment="Left" Click="BtnSaveManualCredentials_Click"/>
 </StackPanel>
 </Expander>
 </StackPanel>
 </Border>

 <!-- Guide Card -->
 <Border Background="#F1F5F9" CornerRadius="8" Padding="14" BorderBrush="#CBD5E1" BorderThickness="1">
 <StackPanel>
 <TextBlock x:Name="TxtGuideTitle" Text="Come Condividere i Progetti con i Colleghi" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,4"/>
 <TextBlock x:Name="TxtGuide1" Text="1. Chi pubblica il progetto: basta premere 'Pubblica su Drive' in Revit." Foreground="#475569" Margin="0,0,0,2"/>
 <TextBlock x:Name="TxtGuide2" Text="2. Aggiungi i colleghi: usa il pulsante 'Condividi Progetto' e inserisci la loro email Google." Foreground="#475569" Margin="0,0,0,2"/>
 <TextBlock x:Name="TxtGuide3" Text="3. I colleghi: aprendo 'Progetti Cloud' troveranno automaticamente il progetto pronto da aprire." Foreground="#475569"/>
 </StackPanel>
 </Border>
 </StackPanel>
 </ScrollViewer>

 <!-- Footer -->
 <DockPanel Grid.Row="2" Margin="0,8,0,0">
 <Button x:Name="BtnRefresh" Content="Aggiorna Stato" Width="130" Height="34" Background="#E2E8F0" Foreground="#334155" BorderThickness="0" FontWeight="SemiBold" Click="BtnRefresh_Click"/>
 <Button x:Name="BtnClose" Content="Chiudi" Width="90" Height="34" HorizontalAlignment="Right" Background="#F1F5F9" Foreground="#475569" BorderThickness="1" BorderBrush="#CBD5E1" Click="BtnClose_Click"/>
 </DockPanel>
 </Grid>
</Window>
