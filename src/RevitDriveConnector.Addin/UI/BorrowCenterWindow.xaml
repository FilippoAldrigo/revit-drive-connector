<Window x:Class="RevitDriveConnector.Addin.UI.BorrowCenterWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Centro Gestione Prestiti &amp; Richieste (Worksharing Monitor)" Height="540" Width="800"
 WindowStartupLocation="CenterScreen"
 FontFamily="Segoe UI" FontSize="13"
 Background="#F4F5F7">

 <Grid Margin="18">
 <Grid.RowDefinitions>
 <RowDefinition Height="Auto"/>
 <RowDefinition Height="*"/>
 <RowDefinition Height="Auto"/>
 </Grid.RowDefinitions>

 <!-- Header -->
 <DockPanel Grid.Row="0" Margin="0,0,0,15">
 <StackPanel>
 <TextBlock x:Name="TxtHeaderTitle" Text="Gestione Prestiti Elementi in Tempo Reale" FontSize="20" FontWeight="SemiBold" Foreground="#1E293B"/>
 <TextBlock x:Name="TxtHeaderSubtitle" Text="Scambia i permessi di modifica sugli oggetti BIM senza dover attendere la sincronizzazione completa." Foreground="#64748B" Margin="0,4,0,0"/>
 </StackPanel>
 <Button x:Name="BtnRefresh" Content="Aggiorna" Width="100" Height="34" HorizontalAlignment="Right" Background="#E2E8F0" Foreground="#334155" BorderThickness="0" FontWeight="SemiBold" Click="BtnRefresh_Click"/>
 </DockPanel>

 <!-- Tab Control for Incoming vs Outgoing -->
 <TabControl Grid.Row="1" Background="White" BorderBrush="#E2E8F0">
 <!-- Tab 1: Richieste Ricevute -->
 <TabItem x:Name="TabIncoming" Header="Richieste Ricevute (Da approvare)">
 <Grid Margin="10">
 <Grid.RowDefinitions>
 <RowDefinition Height="*"/>
 <RowDefinition Height="Auto"/>
 </Grid.RowDefinitions>

 <ListView x:Name="LvIncoming" SelectionMode="Single">
 <ListView.View>
 <GridView>
 <GridViewColumn x:Name="ColIncColleague" Header="Collega" Width="130" DisplayMemberBinding="{Binding RequesterUser}" />
 <GridViewColumn x:Name="ColIncElement" Header="Elemento Richiesto" Width="320" DisplayMemberBinding="{Binding ElementName}" />
 <GridViewColumn x:Name="ColIncMachine" Header="Computer" Width="120" DisplayMemberBinding="{Binding RequesterMachine}" />
 <GridViewColumn x:Name="ColIncDate" Header="Data" Width="140" DisplayMemberBinding="{Binding CreatedAtUtc, StringFormat='{}{0:dd/MM HH:mm}'}" />
 </GridView>
 </ListView.View>
 </ListView>

 <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
 <Button x:Name="BtnDeny" Content="Rifiuta" Width="110" Height="34" Margin="0,0,10,0" Background="#FEE2E2" Foreground="#991B1B" BorderThickness="0" FontWeight="Bold" Click="BtnDeny_Click"/>
 <Button x:Name="BtnGrant" Content="Concedi Prestito" Width="150" Height="34" Background="#10B981" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnGrant_Click"/>
 </StackPanel>
 </Grid>
 </TabItem>

 <!-- Tab 2: Richieste Inviate -->
 <TabItem x:Name="TabOutgoing" Header="Mie Richieste Inviate">
 <Grid Margin="10">
 <Grid.RowDefinitions>
 <RowDefinition Height="*"/>
 <RowDefinition Height="Auto"/>
 </Grid.RowDefinitions>

 <ListView x:Name="LvOutgoing" SelectionMode="Single">
 <ListView.View>
 <GridView>
 <GridViewColumn x:Name="ColOutOwner" Header="Proprietario Attuale" Width="150" DisplayMemberBinding="{Binding OwnerUser}" />
 <GridViewColumn x:Name="ColOutElement" Header="Elemento" Width="340" DisplayMemberBinding="{Binding ElementName}" />
 <GridViewColumn x:Name="ColOutStatus" Header="Stato Richiesta" Width="130" DisplayMemberBinding="{Binding Status}" />
 <GridViewColumn x:Name="ColOutDate" Header="Data" Width="110" DisplayMemberBinding="{Binding CreatedAtUtc, StringFormat='{}{0:dd/MM HH:mm}'}" />
 </GridView>
 </ListView.View>
 </ListView>

 <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
 <Button x:Name="BtnCheckout" Content="Prendi in Carico Elementi Approvati" Width="230" Height="34" Background="#0284C7" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnCheckoutApproved_Click"/>
 </StackPanel>
 </Grid>
 </TabItem>
 </TabControl>

 <!-- Bottom Footer -->
 <DockPanel Grid.Row="2" Margin="0,15,0,0">
 <Button x:Name="BtnRelinquish" Content="Rilascia Tutti i Miei Elementi (Relinquish All)" Width="270" Height="36" Background="#FEF3C7" Foreground="#92400E" BorderThickness="1" BorderBrush="#FCD34D" FontWeight="SemiBold" Click="BtnRelinquishAll_Click"/>
 <Button x:Name="BtnClose" Content="Chiudi" Width="90" Height="36" HorizontalAlignment="Right" Background="#F1F5F9" Foreground="#475569" BorderThickness="1" BorderBrush="#CBD5E1" Click="BtnClose_Click"/>
 </DockPanel>
 </Grid>
</Window>
