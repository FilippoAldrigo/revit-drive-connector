<Window x:Class="RevitDriveConnector.Addin.UI.ShareProjectWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Google Drive Connector - Condividi con Collaboratori" 
 Height="560" Width="680"
 WindowStartupLocation="CenterScreen"
 FontFamily="Segoe UI" FontSize="13"
 Background="#F8FAFC" ResizeMode="NoResize">

 <Grid Margin="20">
 <Grid.RowDefinitions>
 <RowDefinition Height="Auto"/>
 <RowDefinition Height="Auto"/>
 <RowDefinition Height="*"/>
 <RowDefinition Height="Auto"/>
 </Grid.RowDefinitions>

 <!-- Header -->
 <StackPanel Grid.Row="0" Margin="0,0,0,16">
 <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
 <TextBlock x:Name="TxtHeaderTitle" Text="Condivisione Progetto Cloud" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
 </StackPanel>
 <TextBlock x:Name="TxtHeaderSubtitle" Text="Aggiungi l'indirizzo email Google dei tuoi colleghi. Riceveranno l'accesso su Google Drive e potranno aprire il progetto direttamente da Revit con un clic." 
 Foreground="#64748B" TextWrapping="Wrap"/>
 
 <!-- Project Name Badge -->
 <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
 <DockPanel>
 <TextBlock x:Name="LblSelectedProject" Text="Progetto selezionato:" Foreground="#0369A1" FontWeight="Medium" Width="140"/>
 <TextBlock x:Name="TxtProjectName" Text="Caricamento..." Foreground="#0284C7" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
 </DockPanel>
 </Border>
 </StackPanel>

 <!-- Add Collaborator Input Card -->
 <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16" Margin="0,0,0,16">
 <StackPanel>
 <TextBlock x:Name="TxtAddHeader" Text="Aggiungi un nuovo collaboratore" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,10"/>

 <Grid Margin="0,0,0,8">
 <Grid.ColumnDefinitions>
 <ColumnDefinition Width="*"/>
 <ColumnDefinition Width="10"/>
 <ColumnDefinition Width="140"/>
 <ColumnDefinition Width="10"/>
 <ColumnDefinition Width="110"/>
 </Grid.ColumnDefinitions>

 <!-- Email Box -->
 <TextBox x:Name="TxtEmail" Grid.Column="0" Height="36" VerticalContentAlignment="Center" 
 Padding="10,0" BorderBrush="#CBD5E1" Text="collega@gmail.com" Foreground="#334155"
 GotFocus="TxtEmail_GotFocus" KeyDown="TxtEmail_KeyDown"/>

 <!-- Role Selector -->
 <ComboBox x:Name="CmbRole" Grid.Column="2" Height="36" VerticalContentAlignment="Center" SelectedIndex="0">
 <ComboBoxItem x:Name="CmbItemEditor" Content="Editor"/>
 <ComboBoxItem x:Name="CmbItemViewer" Content="Visualizzatore"/>
 </ComboBox>

 <!-- Add Button -->
 <Button x:Name="BtnAdd" Grid.Column="4" Content="Aggiungi" Height="36" 
 Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" 
 Cursor="Hand" Click="BtnAdd_Click"/>
 </Grid>

 <DockPanel Margin="0,2,0,0">
 <CheckBox x:Name="ChkNotify" Content="Invia notifica di invito via email da Google" IsChecked="True" 
 Foreground="#64748B" VerticalAlignment="Center"/>
 <TextBlock x:Name="TxtFeedback" Text="" HorizontalAlignment="Right" VerticalAlignment="Center" 
 FontWeight="Medium" Foreground="#0284C7"/>
 </DockPanel>
 </StackPanel>
 </Border>

 <!-- Current Collaborators List -->
 <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="6">
 <Grid>
 <Grid.RowDefinitions>
 <RowDefinition Height="Auto"/>
 <RowDefinition Height="*"/>
 </Grid.RowDefinitions>

 <TextBlock x:Name="TxtActiveMembers" Grid.Row="0" Text="Membri del team con accesso a questo progetto:" FontWeight="SemiBold" Foreground="#475569" Margin="10,8,0,8"/>

 <ListView x:Name="LvCollaborators" Grid.Row="1" BorderThickness="0">
 <ListView.View>
 <GridView>
 <GridViewColumn x:Name="ColEmail" Header="Email Google" Width="240">
 <GridViewColumn.CellTemplate>
 <DataTemplate>
 <TextBlock Text="{Binding Email}" FontWeight="SemiBold" Foreground="#1E293B"/>
 </DataTemplate>
 </GridViewColumn.CellTemplate>
 </GridViewColumn>
 <GridViewColumn x:Name="ColName" Header="Nome" Width="140" DisplayMemberBinding="{Binding DisplayName}" />
 <GridViewColumn x:Name="ColRole" Header="Permesso" Width="130" DisplayMemberBinding="{Binding RoleDisplay}" />
 <GridViewColumn x:Name="ColAction" Header="Azione" Width="80">
 <GridViewColumn.CellTemplate>
 <DataTemplate>
 <Button Content="Rimuovi" Padding="6,2" Background="#FEE2E2" Foreground="#991B1B" 
 BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnRemove_Click"/>
 </DataTemplate>
 </GridViewColumn.CellTemplate>
 </GridViewColumn>
 </GridView>
 </ListView.View>
 </ListView>
 </Grid>
 </Border>

 <!-- Footer -->
 <DockPanel Grid.Row="3" Margin="0,16,0,0">
 <Button x:Name="BtnRefresh" Content="Aggiorna Lista" Width="130" Height="36" Background="#E2E8F0" Foreground="#334155" 
 BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnRefresh_Click"/>
 <Button x:Name="BtnClose" Content="Chiudi" Width="100" Height="36" HorizontalAlignment="Right" Background="#F1F5F9" 
 Foreground="#475569" BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand" Click="BtnClose_Click"/>
 </DockPanel>
 </Grid>
</Window>
