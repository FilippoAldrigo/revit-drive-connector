<Window x:Class="RevitDriveConnector.Addin.UI.ManageLinksWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Google Drive Connector - Gestione Collegamenti Esterni"
 Height="540" Width="820"
 WindowStartupLocation="CenterScreen"
 FontFamily="Segoe UI" FontSize="13"
 Background="#F8FAFC">

 <Grid Margin="20">
 <Grid.RowDefinitions>
 <RowDefinition Height="Auto"/>
 <RowDefinition Height="Auto"/>
 <RowDefinition Height="*"/>
 <RowDefinition Height="Auto"/>
 <RowDefinition Height="Auto"/>
 </Grid.RowDefinitions>

 <!-- Header -->
 <StackPanel Grid.Row="0" Margin="0,0,0,14">
 <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
 <TextBlock x:Name="TxtHeaderTitle" Text="Gestione Collegamenti Esterni Cloud" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
 </StackPanel>
 <TextBlock x:Name="TxtHeaderSubtitle" Text="Converti automaticamente tutti i collegamenti (Revit, DWG, IFC) in percorsi relativi all'interno della cartella Links di Google Drive per evitare errori di 'Collegamento non trovato' tra i colleghi del team."
 Foreground="#64748B" TextWrapping="Wrap"/>
 </StackPanel>

 <!-- Alert Banner -->
 <Border x:Name="AlertBanner" Grid.Row="1" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
 <StackPanel Orientation="Horizontal">
 <TextBlock x:Name="TxtAlertMessage" Text="Rilevati collegamenti esterni con percorsi assoluti locali. Clicca su 'Consolida' per condividerli su Drive."
 Foreground="#92400E" FontWeight="Medium" VerticalAlignment="Center"/>
 </StackPanel>
 </Border>

 <!-- Links List -->
 <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
 <ListView x:Name="LvLinks" BorderThickness="0" Margin="4">
 <ListView.View>
 <GridView>
 <GridViewColumn x:Name="ColName" Header="Nome File" Width="170">
 <GridViewColumn.CellTemplate>
 <DataTemplate>
 <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1E293B"/>
 </DataTemplate>
 </GridViewColumn.CellTemplate>
 </GridViewColumn>
 <GridViewColumn x:Name="ColType" Header="Tipo" Width="90" DisplayMemberBinding="{Binding ReferenceType}" />
 <GridViewColumn x:Name="ColPath" Header="Percorso Attuale" Width="360" DisplayMemberBinding="{Binding CurrentPath}" />
 <GridViewColumn x:Name="ColStatus" Header="Stato" Width="160">
 <GridViewColumn.CellTemplate>
 <DataTemplate>
 <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
 <TextBlock Text="{Binding StatusDescription}" FontWeight="SemiBold" Foreground="{Binding StatusColor}"/>
 </Border>
 </DataTemplate>
 </GridViewColumn.CellTemplate>
 </GridViewColumn>
 </GridView>
 </ListView.View>
 </ListView>
 </Border>

 <!-- Progress or Status text -->
 <TextBlock x:Name="TxtStatus" Grid.Row="3" Text="" Foreground="#0284C7" Margin="0,10,0,10" FontWeight="Medium"/>

 <!-- Action Buttons Footer -->
 <DockPanel Grid.Row="4">
 <Button x:Name="BtnRefresh" Content="Aggiorna Elenco" Width="140" Height="38" Background="#E2E8F0" Foreground="#334155"
 BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnRefresh_Click"/>

 <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
 <Button x:Name="BtnClose" Content="Chiudi" Width="100" Height="38" Margin="0,0,10,0" Background="#F1F5F9"
 Foreground="#475569" BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand" Click="BtnClose_Click"/>

 <Button x:Name="BtnConsolidate" Content="Consolida e Relativizza su Drive" Height="38" Padding="16,0"
 Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnConsolidate_Click">
 <Button.Style>
 <Style TargetType="Button">
 <Setter Property="Template">
 <Setter.Value>
 <ControlTemplate TargetType="Button">
 <Border Background="{TemplateBinding Background}" CornerRadius="6">
 <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
 </Border>
 </ControlTemplate>
 </Setter.Value>
 </Setter>
 <Style.Triggers>
 <Trigger Property="IsMouseOver" Value="True">
 <Setter Property="Background" Value="#0369A1"/>
 </Trigger>
 </Style.Triggers>
 </Style>
 </Button.Style>
 </Button>
 </StackPanel>
 </DockPanel>
 </Grid>
</Window>
