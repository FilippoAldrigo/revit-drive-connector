<Window x:Class="RevitDriveConnector.Addin.UI.BorrowToastWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Notifica Prestito Elemento"
 Width="400" SizeToContent="Height"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 Topmost="True" ShowInTaskbar="False" ShowActivated="False"
 FontFamily="Segoe UI" FontSize="13">

 <Border Background="#1E293B" CornerRadius="12" BorderBrush="#38BDF8" BorderThickness="1.5" Margin="10">
 <Border.Effect>
 <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.5" Color="Black"/>
 </Border.Effect>

 <Grid Margin="16">
 <Grid.RowDefinitions>
 <RowDefinition Height="Auto"/>
 <RowDefinition Height="Auto"/>
 <RowDefinition Height="Auto"/>
 <RowDefinition Height="Auto"/>
 </Grid.RowDefinitions>

 <!-- Header Row with Notification Title and Close Button -->
 <DockPanel Grid.Row="0" Margin="0,0,0,10">
 <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
 <TextBlock x:Name="TxtTitle" Text="Richiesta di Modifica Elemento" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC" VerticalAlignment="Center"/>
 </StackPanel>
 <Button x:Name="BtnClose" Content="X" Width="26" Height="26" HorizontalAlignment="Right"
 Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
 FontSize="13" FontWeight="Bold" Cursor="Hand" Click="BtnClose_Click">
 <Button.Style>
 <Style TargetType="Button">
 <Setter Property="Template">
 <Setter.Value>
 <ControlTemplate TargetType="Button">
 <Border Background="{TemplateBinding Background}" CornerRadius="13">
 <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
 </Border>
 </ControlTemplate>
 </Setter.Value>
 </Setter>
 <Style.Triggers>
 <Trigger Property="IsMouseOver" Value="True">
 <Setter Property="Foreground" Value="#FFFFFF"/>
 <Setter Property="Background" Value="#334155"/>
 </Trigger>
 </Style.Triggers>
 </Style>
 </Button.Style>
 </Button>
 </DockPanel>

 <!-- Body Message -->
 <StackPanel Grid.Row="1" Margin="0,0,0,12">
 <TextBlock x:Name="TxtPrompt" Text="ti chiede il permesso di modificare:" Foreground="#CBD5E1" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"/>

 <!-- Element Details Card -->
 <Border Background="#0F172A" CornerRadius="8" Padding="12,10" BorderBrush="#334155" BorderThickness="1">
 <StackPanel>
 <DockPanel Margin="0,0,0,4">
 <TextBlock x:Name="LblElement" Text="Elemento:" Foreground="#64748B" FontSize="11" Width="75"/>
 <TextBlock x:Name="TxtElementName" Text="Elemento Revit" FontWeight="SemiBold" Foreground="#38BDF8" TextTrimming="CharacterEllipsis"/>
 </DockPanel>
 <DockPanel Margin="0,0,0,4">
 <TextBlock x:Name="LblUniqueId" Text="ID Univoco:" Foreground="#64748B" FontSize="11" Width="75"/>
 <TextBlock x:Name="TxtElementId" Text="0" FontWeight="Bold" Foreground="#E2E8F0"/>
 </DockPanel>
 <DockPanel x:Name="PanelMessage" Visibility="Collapsed">
 <TextBlock x:Name="LblMessage" Text="Messaggio:" Foreground="#64748B" FontSize="11" Width="75"/>
 <TextBlock x:Name="TxtMessage" Text="" FontStyle="Italic" Foreground="#94A3B8" TextWrapping="Wrap"/>
 </DockPanel>
 </StackPanel>
 </Border>
 </StackPanel>

 <!-- Action Status Message (Shown after clicking) -->
 <TextBlock x:Name="TxtActionStatus" Grid.Row="2" Text="" FontWeight="SemiBold" Foreground="#10B981" Margin="0,0,0,10" Visibility="Collapsed" HorizontalAlignment="Center"/>

 <!-- Action Buttons Row -->
 <Grid x:Name="PanelButtons" Grid.Row="3">
 <Grid.ColumnDefinitions>
 <ColumnDefinition Width="*"/>
 <ColumnDefinition Width="10"/>
 <ColumnDefinition Width="*"/>
 </Grid.ColumnDefinitions>

 <!-- Concedi Button -->
 <Button x:Name="BtnGrant" Grid.Column="0" Content="Concedi" Height="36"
 Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="13"
 BorderThickness="0" Cursor="Hand" Click="BtnGrant_Click">
 <Button.Style>
 <Style TargetType="Button">
 <Setter Property="Template">
 <Setter.Value>
 <ControlTemplate TargetType="Button">
 <Border Background="{TemplateBinding Background}" CornerRadius="6">
 <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
 </Border>
 </ControlTemplate>
 </Setter.Value>
 </Setter>
 <Style.Triggers>
 <Trigger Property="IsMouseOver" Value="True">
 <Setter Property="Background" Value="#059669"/>
 </Trigger>
 </Style.Triggers>
 </Style>
 </Button.Style>
 </Button>

 <!-- Rifiuta Button -->
 <Button x:Name="BtnDeny" Grid.Column="2" Content="Rifiuta" Height="36"
 Background="#334155" Foreground="#F1F5F9" FontWeight="SemiBold" FontSize="13"
 BorderThickness="0" Cursor="Hand" Click="BtnDeny_Click">
 <Button.Style>
 <Style TargetType="Button">
 <Setter Property="Template">
 <Setter.Value>
 <ControlTemplate TargetType="Button">
 <Border Background="{TemplateBinding Background}" CornerRadius="6">
 <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
 </Border>
 </ControlTemplate>
 </Setter.Value>
 </Setter>
 <Style.Triggers>
 <Trigger Property="IsMouseOver" Value="True">
 <Setter Property="Background" Value="#DC2626"/>
 </Trigger>
 </Style.Triggers>
 </Style>
 </Button.Style>
 </Button>
 </Grid>

 <!-- OK / Informational Button (for Outgoing notifications) -->
 <Button x:Name="BtnOk" Grid.Row="3" Content="Capito / Chiudi" Height="36"
 Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="13"
 BorderThickness="0" Cursor="Hand" Visibility="Collapsed" Click="BtnClose_Click">
 <Button.Style>
 <Style TargetType="Button">
 <Setter Property="Template">
 <Setter.Value>
 <ControlTemplate TargetType="Button">
 <Border Background="{TemplateBinding Background}" CornerRadius="6">
 <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
 </Border>
 </ControlTemplate>
 </Setter.Value>
 </Setter>
 <Style.Triggers>
 <Trigger Property="IsMouseOver" Value="True">
 <Setter Property="Background" Value="#0369A1"/>
 </Trigger>
 </Style.Triggers>
 </Style>
 </Button.Style>
 </Button>
 </Grid>
 </Border>
</Window>
