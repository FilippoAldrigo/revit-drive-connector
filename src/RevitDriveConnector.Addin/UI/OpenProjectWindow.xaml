<Window x:Class="RevitDriveConnector.Addin.UI.OpenProjectWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Google Drive Connector - Progetti Cloud" Height="560" Width="890"
 WindowStartupLocation="CenterScreen"
 FontFamily="Segoe UI" FontSize="13"
 Background="#F4F5F7">

 <Grid Margin="18">
 <Grid.RowDefinitions>
 <RowDefinition Height="Auto"/>
 <RowDefinition Height="*"/>
 <RowDefinition Height="Auto"/>
 <RowDefinition Height="Auto"/>
 </Grid.RowDefinitions>

 <!-- Header with Account Badge -->
 <DockPanel Grid.Row="0" Margin="0,0,0,14">
 <StackPanel VerticalAlignment="Center">
 <TextBlock x:Name="TxtHeaderTitle" Text="Progetti Condivisi su Google Drive" FontSize="20" FontWeight="SemiBold" Foreground="#1E293B"/>
 <TextBlock x:Name="TxtHeaderSubtitle" Text="Seleziona un progetto centrale dal cloud. Verra sincronizzato e aperto come modello locale sul tuo computer." Foreground="#64748B" Margin="0,4,0,0"/>
 </StackPanel>

 <!-- Google Account Badge -->
 <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="White" CornerRadius="18" Padding="10,6" BorderBrush="#CBD5E1" BorderThickness="1">
 <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
 <TextBlock x:Name="TxtAccountBadge" Text="Account Google non connesso" Foreground="#64748B" VerticalAlignment="Center" FontWeight="Medium"/>
 <Button x:Name="BtnManageAccount" Content="Gestisci" Margin="10,0,0,0" Padding="8,2" Background="#F1F5F9" Foreground="#0284C7" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnManageAccount_Click"/>
 </StackPanel>
 </Border>
 </DockPanel>

 <!-- Projects List -->
 <Border Grid.Row="1" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1">
 <ListView x:Name="LvProjects" BorderThickness="0" Margin="4" SelectionMode="Single" SelectionChanged="LvProjects_SelectionChanged">
 <ListView.View>
 <GridView>
 <GridViewColumn x:Name="ColName" Header="Nome Progetto" Width="230" DisplayMemberBinding="{Binding Name}" />
 <GridViewColumn x:Name="ColSource" Header="Origine" Width="200" DisplayMemberBinding="{Binding SourceDisplay}" />
 <GridViewColumn x:Name="ColStatus" Header="Stato" Width="140" DisplayMemberBinding="{Binding StatusDisplay}" />
 <GridViewColumn x:Name="ColVersion" Header="Versione" Width="70" DisplayMemberBinding="{Binding Version}" />
 <GridViewColumn x:Name="ColModified" Header="Ultima Modifica" Width="140" DisplayMemberBinding="{Binding LastModifiedLocal, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" />
 </GridView>
 </ListView.View>
 </ListView>
 </Border>

 <!-- Options & Status / Feedback -->
 <StackPanel Grid.Row="2" Margin="0,10,0,10">
 <CheckBox x:Name="ChkCreateNewLocal" Content="Crea nuova copia locale aggiornata dal Centrale (Consigliato)" IsChecked="True" Foreground="#1E293B" FontWeight="SemiBold" Margin="0,0,0,6"/>
 <TextBlock x:Name="TxtStatus" Text="Caricamento progetti in corso..." Foreground="#0284C7" FontWeight="Medium"/>
 </StackPanel>

 <!-- Action Buttons -->
 <DockPanel Grid.Row="3">
 <StackPanel Orientation="Horizontal">
 <Button x:Name="BtnRefresh" Content="Aggiorna Elenco" Width="140" Height="36" Background="#E2E8F0" Foreground="#334155" BorderThickness="0" FontWeight="SemiBold" Click="BtnRefresh_Click"/>
 <Button x:Name="BtnShare" Content="Collaboratori..." Width="150" Height="36" Margin="10,0,0,0" Background="#F1F5F9" Foreground="#0284C7" BorderThickness="1" BorderBrush="#BAE6FD" FontWeight="Bold" IsEnabled="False" Click="BtnShare_Click"/>
 </StackPanel>

 <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
 <Button x:Name="BtnCancel" Content="Annulla" Width="100" Height="36" Margin="0,0,10,0" Background="#F1F5F9" Foreground="#475569" BorderThickness="1" BorderBrush="#CBD5E1" Click="BtnCancel_Click"/>
 <Button x:Name="BtnOpen" Content="Apri Modello Locale" Width="180" Height="36" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" IsEnabled="False" Click="BtnOpen_Click"/>
 </StackPanel>
 </DockPanel>
 </Grid>
</Window>
